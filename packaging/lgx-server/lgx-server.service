[Unit]
Description=lgx HEVC server (stream this Wayland session)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Environment=WAYLAND_DISPLAY=wayland-1
ExecStart=/usr/bin/lgx-server --audio
Restart=on-failure
RestartSec=2
# The server needs Wayland, DRM/VAAPI, PipeWire and TCP; keep the rest of the
# system out of reach. It must stay able to write ~/.config/lgx, so home is
# readable but not the unit's sandbox.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
# The file clipboard reads user-chosen paths; a private /tmp would hide
# files copied from /tmp. The service is still protected by ProtectSystem.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
