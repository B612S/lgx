# Maintainer: B612S
pkgname=lgx-client
pkgver=0.2.0
pkgrel=37
pkgdesc='lgx: zero-copy HEVC client (NVDEC/VAAPI decode)'
arch=('x86_64')
url='https://github.com/B612S/lgx'
license=('MIT')
depends=('gcc-libs' 'sdl3' 'ffmpeg' 'vulkan-icd-loader' 'mesa' 'libxkbcommon' 'wl-clipboard' 'pipewire' 'libpulse' 'qt6-base')
makedepends=('cargo' 'rust' 'ffmpeg' 'qt6-base' 'pkgconf')
source=("lgx-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "lgx-$pkgver"
  # ring ships its own C/asm; Arch's hardening CFLAGS break its static
  # library link order. Use the crate's own flags for this Rust-only build.
  unset CFLAGS CXXFLAGS LDFLAGS
  cargo build --release --locked -p lgx-client
  g++ -std=c++17 -O2 -fPIC helper/lgx-reconnect-qt.cpp \
    -o lgx-reconnect-qt $(pkg-config --cflags --libs Qt6Widgets)
}

package() {
  cd "lgx-$pkgver"
  install -Dm755 target/release/lgx-client "$pkgdir/usr/bin/lgx-client"
  install -Dm755 lgx-reconnect-qt "$pkgdir/usr/bin/lgx-reconnect-qt"
  install -Dm644 packaging/lgx-client/lgx-client.desktop \
    "$pkgdir/usr/share/applications/lgx-client.desktop"
  install -Dm644 assets/lgx.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/lgx.svg"
  for size in 32 48 64 128 256; do
    install -Dm644 "assets/lgx-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lgx.png"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
